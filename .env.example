# --- Speech-to-text ---
# Leave DEEPGRAM_API_KEY unset to fall back to local faster-whisper streaming.
DEEPGRAM_API_KEY=

# --- Mid-sentence intent classifier fallback (used only when the regex
#     tokenizer in intent_engine.py finds no match) ---
# Anthropic is used by default since Claude Haiku is fast/cheap enough for
# low-latency mid-utterance classification. Gemini is supported as an
# alternative backend.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Spotify ---
# Optional. Create a free app at https://developer.spotify.com/dashboard,
# add http://127.0.0.1:8888/callback as a Redirect URI, paste the Client ID.
# First "play ..." opens a browser login; the token is cached afterwards.
# API playback (auto-pick the top hit, volume, shuffle) needs Spotify Premium.
# Without this, "play <song>" still opens Spotify search and hits Enter.
SPOTIFY_CLIENT_ID=

# --- Behavior ---
# "deepgram" or "whisper". If unset, auto-selects based on DEEPGRAM_API_KEY.
STT_BACKEND=

# Spoken language: "en" or "de". German needs a multilingual Whisper model
# (small, not small.en). English-only checkpoints are swapped automatically.
STT_LANGUAGE=en

# Local Whisper model when using the whisper backend. small.en is the
# CPU default for English (about a second). For German use small.
# distil-large-v3 is more accurate and much slower, and it is English-only.
WHISPER_MODEL=small.en

# Microphone to capture from. Leave empty for the Windows default recording
# device. Otherwise either a device index or (preferred, since indices shift
# when USB devices are plugged/unplugged) a case-insensitive substring of the
# device name. List devices with: python -m sounddevice
MIC_DEVICE=

# Default browser used by browser_search()/navigate_url() when the spoken
# command doesn't name one explicitly. One of: default, chrome, edge, arc, firefox
DEFAULT_BROWSER=default

# --- Listening mode ---
# "ptt" (default): the mic is only captured while a hotkey is engaged - hold
#   Right Alt, or press Ctrl+Alt+A to toggle listening on/off. No hotkey
#   engaged means no mic capture at all.
# "wakeword": the mic stays open. With openwakeword installed, Whisper runs
#   only after "hey jarvis". Without that model, every utterance is
#   transcribed and ignored until the text contains "jarvis" / "hey jarvis".
LISTENING_MODE=ptt

# PTT-mode hotkeys (only used when LISTENING_MODE=ptt). PTT_HOLD_KEY must be
# a pynput Key name (see https://pynput.readthedocs.io/en/latest/keyboard.html#pynput.keyboard.Key).
# The toggle combo is always Ctrl+Left Alt+<PTT_TOGGLE_LETTER>.
PTT_HOLD_KEY=alt_r
PTT_TOGGLE_LETTER=a

# Speak a short confirmation when a command runs. Language follows
# STT_LANGUAGE. Set to 0 to keep the pill silent.
# TTS_VOICE is an optional substring of an installed SAPI voice name.
TTS_ENABLED=1
TTS_VOICE=
